rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Slips subcollection
      match /slips/{slipId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Predictions: authenticated users can read games
    match /predictions/{date}/games/{gameId} {
      allow read: if request.auth != null;
      allow write: if false; // block client writes
    }

    // Learning: global read-only
    match /learning/global {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Learning per-user: users can read their own
    match /learning/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Live tracking: authenticated users can read
    match /live_tracking/{matchId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Block any other client writes to restricted root collections
    match /predictions/{document=**} {
      allow write: if false;
    }

    match /learning/global/{document=**} {
      allow write: if false;
    }

    match /live_tracking/{document=**} {
      allow write: if false;
    }

  }
}
